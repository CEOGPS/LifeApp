{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "allowJs": true,
    "checkJs": false,

    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.tsx", "src/**/*.ts", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "electron-dist",
    ".wrangler",

    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/tests/**",
    "src/**/__tests__/**",
    "src/vitest.setup.ts",

    "src/_core/**",
    "src/_core/_core/**",

    "src/pages/integrations/Nexus-Connect/**",
    "src/pages/lucid/**",
    "src/pages/veriton/**",
    "src/pages/OmniSearch/**",
    "src/pages/social/SocialLink/**",

    "src/lib/agents/advanced_agent/**",
    "src/lib/agents/lucid/**",
    "src/lib/agents/kranos/**",
    "src/lib/agents/erebus/**",
    "src/components/slider.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}